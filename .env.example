# Copy to .env.local and fill in the values printed by `npx supabase start` (local) or your
# Supabase project settings (production). Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used for account deletion and anonymous analytics inserts.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed to test "Continue with Google" locally (Supabase reads these).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
